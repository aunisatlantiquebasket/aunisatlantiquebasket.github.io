<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%# Référencement : titre et description propres à chaque page, aperçu des liens partagés (Facebook, WhatsApp…) %>
  <% const shared = typeof article !== 'undefined' ? article : null; %>
  <% const pageTeam = typeof team !== 'undefined' && currentPath.startsWith('/equipes/') ? team : null; %>
  <% const descriptions = {
    '/': `${club.name}, club de basket du nord de l'Aunis (Marans, Saint-Jean-de-Liversay, Courçon, 17) : équipes jeunes, seniors et loisirs, calendrier, résultats et inscriptions.`,
    '/equipes': `Les équipes d'${club.name} : U7, U9, U11, U13, U15, seniors et loisirs. Championnats, horaires d'entraînement et coachs.`,
    '/aider-aux-matchs': `Matchs à domicile d'${club.name} : inscrivez-vous comme responsable de salle, arbitre, marqueur, chronométreur ou à la buvette.`,
    '/calendrier': `Calendrier et résultats de toutes les équipes d'${club.name}, mis à jour automatiquement avec la FFBB.`,
    '/evenements': `Les événements d'${club.name} : soirées, stages, lotos, assemblées et rendez-vous du club.`,
    '/actualites': `Les actualités d'${club.name} : matchs, vie du club et annonces.`,
    '/trombinoscope': `Le bureau, les commissions, les coachs et les bénévoles d'${club.name}.`,
    '/boutique': `La boutique officielle d'${club.name} : t-shirts, maillots, sweats, vestes, doudounes et casquettes aux couleurs du club, tailles adultes et enfants, prix club.`,
    '/contact': `Contacter ${club.name} : inscriptions, renseignements, salles de Marans, Saint-Jean-de-Liversay et Courçon.`,
  }; %>
  <% const pageDescription = shared ? shared.summary
    : pageTeam ? `${pageTeam.name} d'${club.name} : calendrier, résultats, classement et horaires d'entraînement.`
    : descriptions[currentPath] ?? descriptions['/']; %>
  <% const pageTitle = currentPath === '/' ? `${club.name} · Club de basket à Marans et Saint-Jean-de-Liversay` : `${title} | ${club.name}`; %>
  <title><%= pageTitle %></title>
  <% if ((currentPath.startsWith('/aider-aux-matchs') && !benevoles.visible) || (typeof noindex !== 'undefined' && noindex)) { %><meta name="robots" content="noindex, nofollow"><% } %>
  <meta name="description" content="<%= pageDescription %>">
  <link rel="canonical" href="<%= club.siteUrl + currentPath %>">
  <meta property="og:type" content="<%= shared ? 'article' : 'website' %>">
  <meta property="og:site_name" content="<%= club.name %>">
  <meta property="og:locale" content="fr_FR">
  <meta property="og:url" content="<%= club.siteUrl + currentPath %>">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= pageDescription %>">
  <%# Visuel de partage : image de l'article, visuel propre à la page (shareImage, 1200×630) ou visuel du club %>
  <% const pageShareImage = typeof shareImage !== 'undefined' ? shareImage : null; %>
  <meta property="og:image" content="<%= club.siteUrl + (shared && shared.image ? shared.image : pageShareImage ?? '/img/partage.png') %>">
  <% if (!shared || !shared.image) { %><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><% } %>
  <meta property="og:image:alt" content="<%= club.name %>">
  <meta name="twitter:card" content="summary_large_image">
  <%# Fiche d'identité du club pour Google (nom du site, logo, adresse, réseaux sociaux) %>
  <script type="application/ld+json"><%- JSON.stringify([
    { "@context": "https://schema.org", "@type": "WebSite", name: club.name, alternateName: club.shortName, url: club.siteUrl + '/' },
    { "@context": "https://schema.org", "@type": "SportsOrganization", name: club.name, alternateName: club.shortName,
      sport: "Basketball", url: club.siteUrl + '/', logo: club.siteUrl + '/img/app/icon-512.png', image: club.siteUrl + '/img/partage.png',
      slogan: club.slogan, foundingDate: String(club.foundedYear), email: club.email,
      address: { "@type": "PostalAddress", streetAddress: "16 rue du Docteur Quoy", postalCode: "17170", addressLocality: "Saint-Jean-de-Liversay", addressCountry: "FR" },
      sameAs: [club.social.facebook, club.social.instagram] },
  ]).replace(/</g, '\\u003c') %></script>
  <meta name="theme-color" content="#36424a">
  <link rel="icon" type="image/svg+xml" href="/img/logo-rond.svg">
  <%# Application installable (mobile, tablette) : manifeste, icône iOS, service worker dans js/install.js %>
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="apple-touch-icon" href="/img/app/apple-touch-icon.png">
  <meta name="apple-mobile-web-app-title" content="AAB Basket">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/install.css">
</head>
<body>
  <a href="#contenu" class="skip-link">Aller au contenu</a>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="brand">
        <img src="/img/logo-rond.svg" alt="" width="44" height="44">
        <span><%= club.name %></span>
      </a>
      <%# Menu replié (mobile, tablette) : accès direct au contact à côté du bouton du menu %>
      <a href="/contact" class="header-contact" aria-label="Contact" title="Contact"><%- include('icon', { name: 'mail' }) %></a>
      <input type="checkbox" id="nav-toggle" class="nav-toggle">
      <label for="nav-toggle" class="nav-toggle-label" aria-label="Ouvrir le menu">
        <span class="when-closed"><%- include('icon', { name: 'menu' }) %></span>
        <span class="when-open"><%- include('icon', { name: 'close' }) %></span>
      </label>
      <nav class="main-nav" aria-label="Navigation principale">
        <%# L'accueil est accessible par le logo %>
        <% const links = [["/equipes", "Équipes"], ["/calendrier", "Calendrier"], ["/evenements", "Événements"], ...(benevoles.visible ? [["/aider-aux-matchs", "Aider aux matchs"]] : []), ["/actualites", "Actualités"], ...(shopListed ? [["/boutique", "Boutique"]] : []), ["/trombinoscope", "Le club"], ["/contact", "Contact"]]; %>
        <% for (const [href, label] of links) { %>
          <% const active = currentPath.startsWith(href); %>
          <a href="<%= href %>" class="<%= active ? 'active' : '' %>" <%- active ? 'aria-current="page"' : '' %>><%= label %></a>
        <% } %>
        <% if (club.sportEasyUrl) { %>
          <a href="<%= club.sportEasyUrl %>" class="nav-members" data-sporteasy target="_blank" rel="noopener" title="Espace membres (SportEasy)" aria-label="Espace membres (SportEasy)"><%- include('icon', { name: 'sporteasy' }) %> Membres</a>
        <% } %>
      </nav>
    </div>
  </header>
  <main id="contenu">
