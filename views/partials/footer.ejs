  </main>
  <footer class="site-footer">
    <div class="container footer-grid">
      <div class="footer-brand">
        <img src="/img/logo-rond.svg" alt="" width="56" height="56">
        <div>
          <strong><%= club.name %></strong>
          <p><%= club.slogan %><br>Depuis <%= club.foundedYear %></p>
        </div>
      </div>
      <%# Pas de reprise du menu (toujours en haut) : seulement des raccourcis qui n'y sont pas %>
      <div>
        <h3>Accès rapide</h3>
        <ul>
          <li><a href="/contact?sujet=Inscription">S'inscrire</a></li>
          <% if (benevoles.visible) { %><li><a href="/aider-aux-matchs">Aider aux matchs à domicile</a></li><% } %>
          <li><a href="/contact?sujet=B%C3%A9n%C3%A9volat">Devenir bénévole</a></li>
        </ul>
      </div>
      <div>
        <h3>Nous trouver</h3>
        <ul class="footer-contact">
          <%# Communes des salles du club (config.gyms), la liste détaillée est sur la page Contact %>
          <% const gymTowns = [...new Set(club.gyms.map((g) => g.address.match(/\d{5}\s+(.+)$/)?.[1] ?? g.address))]; %>
          <li><%- include('icon', { name: 'pin' }) %><a href="/contact#salles">Nos salles : <%= gymTowns.join(', ') %></a></li>
          <li><%- include('icon', { name: 'mail' }) %><a href="mailto:<%= club.email %>"><%= club.email %></a></li>
        </ul>
        <div class="social">
          <a href="<%= club.social.facebook %>" target="_blank" rel="noopener" aria-label="Facebook"><%- include('icon', { name: 'facebook' }) %></a>
          <a href="<%= club.social.instagram %>" target="_blank" rel="noopener" aria-label="Instagram"><%- include('icon', { name: 'instagram' }) %></a>
          <% if (club.sportEasyUrl) { %><a href="<%= club.sportEasyUrl %>" data-sporteasy target="_blank" rel="noopener" aria-label="Espace membres (SportEasy)" title="Espace membres (SportEasy)"><%- include('icon', { name: 'sporteasy' }) %></a><% } %>
        </div>
      </div>
    </div>
    <div class="container footer-bottom">© <%= new Date().getFullYear() %> <%= club.name %> · Siège : <%= club.address %></div>
  </footer>

  <%- include('install-banner') %>
  <% if (club.sportEasyUrl) { %>
  <%# Android : le lien « Membres » ouvre l'application SportEasy par son adresse sporteasy:// (testé sur Android) ;
      si elle n'est pas installée, le navigateur affiche le site SportEasy. Rien ne change sur iPhone. %>
  <script>
    if (/Android/i.test(navigator.userAgent)) {
      const site = <%- JSON.stringify(club.sportEasyUrl) %>;
      const intent = `intent://#Intent;scheme=sporteasy;package=com.sporteasy.android;S.browser_fallback_url=${encodeURIComponent(site)};end`;
      document.querySelectorAll("[data-sporteasy]").forEach((a) => { a.href = intent; a.removeAttribute("target"); });
    }
  </script>
  <% } %>
</body>
</html>
