<%- include('../partials/header') %>
<% const icon = (name) => include('../partials/icon', { name }); %>
<%- include('../partials/page-header', { eyebrow: 'Contact', heading: 'Parlons', accent: 'basket !', subtitle: 'Une question, une inscription, un partenariat ? Nous vous répondons rapidement.' }) %>

<section class="section">
  <div class="container contact-layout">
    <aside class="contact-cards">
      <a class="contact-card" href="mailto:<%= club.email %>">
        <span class="ql-icon"><%- icon('mail') %></span>
        <span><small>E-mail</small><strong><%= club.email %></strong></span>
      </a>
      <a class="contact-card" href="<%= mapsUrl(club.gym) %>" target="_blank" rel="noopener">
        <span class="ql-icon"><%- icon('route') %></span>
        <span><small>Salle (itinéraire)</small><strong><%= club.gym %></strong></span>
      </a>
      <div class="contact-card">
        <span class="ql-icon"><%- icon('pin') %></span>
        <span><small>Siège</small><strong><%= club.address %></strong></span>
      </div>
      <div class="social social-lg">
        <a href="<%= club.social.facebook %>" target="_blank" rel="noopener"><%- icon('facebook') %> Facebook</a>
        <a href="<%= club.social.instagram %>" target="_blank" rel="noopener"><%- icon('instagram') %> Instagram</a>
      </div>
    </aside>

    <%
      // Pas de formulaire (site statique) : un e-mail prérempli selon le sujet
      const subjects = {
        Inscription: "Bonjour,\n\nJe souhaite m'inscrire (ou inscrire mon enfant) au club.\nNom et prénom du joueur :\nDate de naissance :\nÉquipe souhaitée (si vous la connaissez) :\n\nMerci !",
        Renseignements: "Bonjour,\n\n",
        Partenariat: "Bonjour,\n\nJe vous contacte au sujet d'un partenariat avec le club.\n\n",
        Autre: "Bonjour,\n\n",
      };
      const mailto = (s) => `mailto:${club.email}?subject=${encodeURIComponent(`${s} - ${club.name}`)}&body=${encodeURIComponent(subjects[s])}`;
    %>
    <div class="panel contact-panel" data-contact>
      <h2>Écrivez-nous</h2>
      <p class="muted">Choisissez le sujet : votre messagerie s'ouvre avec un e-mail prêt à compléter.</p>
      <div class="subject-picker" role="group" aria-label="Sujet">
        <% for (const s of Object.keys(subjects)) { %>
          <button type="button" class="chip <%= s === 'Inscription' ? 'active' : '' %>" data-subject="<%= s %>" data-mailto="<%= mailto(s) %>" aria-pressed="<%= s === 'Inscription' %>"><%= s %></button>
        <% } %>
      </div>
      <div class="contact-actions">
        <a class="btn btn-primary btn-lg" href="<%= mailto('Inscription') %>" data-mail-link><%- icon('mail') %> Envoyer un e-mail</a>
      </div>
      <p class="contact-hint">Pas de messagerie sur cet appareil ? Écrivez-nous à <a href="mailto:<%= club.email %>"><%= club.email %></a>.</p>
    </div>
  </div>
</section>
<script>
  // Sujet choisi (et sujet reçu dans l'adresse, ex. /contact?sujet=Inscription) → lien e-mail prérempli
  (() => {
    const root = document.querySelector("[data-contact]");
    const link = root.querySelector("[data-mail-link]");
    const buttons = [...root.querySelectorAll("[data-subject]")];
    const select = (subject) => {
      const button = buttons.find((b) => b.dataset.subject === subject) ?? buttons[0];
      for (const b of buttons) { b.classList.toggle("active", b === button); b.setAttribute("aria-pressed", String(b === button)); }
      link.href = button.dataset.mailto;
    };
    root.addEventListener("click", (e) => { const b = e.target.closest("[data-subject]"); if (b) select(b.dataset.subject); });
    select(new URLSearchParams(location.search).get("sujet") ?? "Inscription");
  })();
</script>
<%- include('../partials/footer') %>
