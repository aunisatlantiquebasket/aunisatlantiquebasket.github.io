{
  "name": "aab-basket",
  "version": "1.0.0",
  "description": "Site web du club Aunis Atlantique Basket",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "sync-ffbb": "tsx src/scripts/sync-ffbb.ts",
    "sync-ffbb:prod": "node dist/scripts/sync-ffbb.js",
    "build:static": "tsx src/scripts/build-static.ts",
    "preview:static": "tsx src/scripts/preview-static.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
